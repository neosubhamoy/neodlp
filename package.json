{
	"name": "neodlp",
	"private": true,
	"version": "0.4.5",
	"description": "Modern Video/Audio Downloader based on YT-DLP with Browser Integration",
	"author": "neosubhamoy <hey@neosubhamoy.com>",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev:linux-x64": "npm run tauri dev -- --config ./src-tauri/tauri.linux-x86_64.conf.json",
		"tauri:build:linux-x64": "npm run tauri build -- --config ./src-tauri/tauri.linux-x86_64.conf.json",
		"tauri:dev:linux-arm64": "npm run tauri dev -- --config ./src-tauri/tauri.linux-aarch64.conf.json",
		"tauri:build:linux-arm64": "npm run tauri build -- --config ./src-tauri/tauri.linux-aarch64.conf.json",
		"tauri:dev:macos-x64": "npm run tauri dev -- --config ./src-tauri/tauri.macos-x86_64.conf.json",
		"tauri:build:macos-x64": "npm run tauri build -- --config ./src-tauri/tauri.macos-x86_64.conf.json",
		"tauri:dev:macos-arm64": "npm run tauri dev -- --config ./src-tauri/tauri.macos-aarch64.conf.json",
		"tauri:build:macos-arm64": "npm run tauri build -- --config ./src-tauri/tauri.macos-aarch64.conf.json",
		"tauri:dev:windows-x64": "npm run tauri dev -- --config ./src-tauri/tauri.windows-x86_64.conf.json",
		"tauri:build:windows-x64": "npm run tauri build -- --config ./src-tauri/tauri.windows-x86_64.conf.json",
		"tauri:dev:windows-arm64": "npm run tauri dev -- --config ./src-tauri/tauri.windows-aarch64.conf.json",
		"tauri:build:windows-arm64": "npm run tauri build -- --config ./src-tauri/tauri.windows-aarch64.conf.json",
		"download": "node ./scripts/download-bins.js",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@tanstack/react-pacer": "^0.24.1",
		"@tanstack/react-pacer-devtools": "^0.9.1",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-query-devtools": "^5.104.1",
		"@tanstack/react-router": "^1.170.42",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tauri-apps/api": "^2.12.2",
		"@tauri-apps/plugin-clipboard-manager": "^2.4.1",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-fs": "^2.6.0",
		"@tauri-apps/plugin-log": "^2.10.0",
		"@tauri-apps/plugin-notification": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-os": "^2.4.0",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-shell": "^2.4.1",
		"@tauri-apps/plugin-sql": "^2.5.0",
		"@tauri-apps/plugin-updater": "^2.13.2",
		"@vidstack/react": "^1.15.7",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"lucide-react": "^1.55.0",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-resizable-panels": "^4.14.3",
		"shadcn": "^4.21.4",
		"sonner": "^2.0.8",
		"ulid": "^3.0.2",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.43",
		"@tauri-apps/cli": "^2.12.1",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.4"
	}
}
